{
  "manifest_version": 3,
  "name": "Taskly Automation & Mindful Usage Controller",
  "version": "2.1.0",
  "description": "Dynamic website usage controller, break cycles, daily quotas, and scheduled blocks synced with your Taskly dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "urlHelper.js",
        "content_universal.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.youtu.be/*",
    "*://youtu.be/*",
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "http://127.0.0.1:47891/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtu.be/*",
        "*://youtu.be/*"
      ],
      "js": ["content_universal.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": ["content_universal.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Taskly Automation Controller",
    "default_popup": "popup.html"
  }
}
