{
  "manifest_version": 3,
  "name": "Taskly Automation & Mindful Usage Controller",
  "version": "2.0.0",
  "description": "Dynamic website usage controller, break cycles, daily quotas, and scheduled blocks synced with your Taskly dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "webNavigation"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "http://127.0.0.1:47891/*",
    "http://localhost:4000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content_instagram.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Taskly Automation Controller",
    "default_popup": "popup.html"
  }
}
