# =========================================================
# Taskly Automation Platform - Environment Variables
# =========================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret_in_production
# Persistent backend storage; production must be a mounted durable volume path.
TASKLY_DB_PATH=./server/data/taskly.db
# Exact deployed frontend origins, comma-separated. Local defaults are configured by server/index.js.
CORS_ORIGINS=http://localhost:5173
# Vite frontend build-time setting. Local development only; production requires HTTPS.
VITE_API_URL=http://localhost:4000/api

# Local Agent Configuration
TASKLY_SERVER_URL=http://localhost:4000

# Optional Outgoing Email Service (Phase 8: Scheduled Messaging)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Taskly Automations" <notifications@taskly.io>

# Optional Webhook Integration (Telegram, Discord, Slack)
WEBHOOK_URL=https://example.com/webhook
