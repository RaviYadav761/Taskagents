# =========================================================
# Taskly Automation Platform - Environment Variables
# =========================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Local Agent Configuration
TASKLY_SERVER_URL=http://localhost:4000

# Optional Outgoing Email Service (Phase 8: Scheduled Messaging)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Taskly Automations" <notifications@taskly.io>

# Optional Webhook Integration (Telegram, Discord, Slack)
WEBHOOK_URL=https://example.com/webhook
